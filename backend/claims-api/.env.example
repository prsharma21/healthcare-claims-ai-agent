# Copy to .env (git-ignored) for local development. Real environment variables take precedence.
# AWS credentials do NOT go here: boto3 uses the standard chain (aws configure / aws login profile locally,
# an IAM role in AWS).
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
